{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 80 },
        "email": { "type": "string", "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "country": { "type": "string", "maxLength": 80 },
        "city": { "type": "string", "maxLength": 80 },
        "preferredLanguage": { "type": "string", "maxLength": 40 },
        "bibleInterests": { "type": "string", "maxLength": 200 },
        "favoriteVerse": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["member", "moderator", "admin"] },
        "totalPoints": { "type": "number" },
        "quizzesCompleted": { "type": "number" },
        "currentStreak": { "type": "number" },
        "highestStreak": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "displayName"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Curated or community Bible quiz",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 60 },
        "difficulty": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "timePerQuestionSeconds": { "type": "number" },
        "pointsPerQuestion": { "type": "number" },
        "questionCount": { "type": "number" },
        "isPublished": { "type": "boolean" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "category", "difficulty"]
    },
    "QuizQuestion": {
      "title": "QuizQuestion",
      "description": "Question within a Bible quiz",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "quizId": { "type": "string", "maxLength": 128 },
        "questionText": { "type": "string", "maxLength": 500 },
        "options": { "type": "string", "description": "Array of 4 options" },
        "correctAnswerIndex": { "type": "number" },
        "explanation": { "type": "string", "maxLength": 500 },
        "scriptureReference": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "quizId", "questionText", "correctAnswerIndex"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Record of a completed quiz by a member",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "quizId": { "type": "string", "maxLength": 128 },
        "quizTitle": { "type": "string", "maxLength": 150 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 80 },
        "userCountry": { "type": "string", "maxLength": 80 },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "pointsEarned": { "type": "number" },
        "percentage": { "type": "number" },
        "timeTakenSeconds": { "type": "number" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "quizId", "userId", "score"]
    },
    "Competition": {
      "title": "Competition",
      "description": "Scheduled live worldwide Bible competition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 60 },
        "difficulty": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "startTime": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "participantLimit": { "type": "number" },
        "status": { "type": "string", "enum": ["upcoming", "live", "completed"] },
        "currentQuestionIndex": { "type": "number" },
        "questionTimerEnd": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 80 },
        "participantCount": { "type": "number" }
      },
      "required": ["id", "title", "startTime", "status"]
    },
    "CompetitionParticipant": {
      "title": "CompetitionParticipant",
      "description": "Registered or active participant in a live competition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "competitionId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 80 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "country": { "type": "string", "maxLength": 80 },
        "score": { "type": "number" },
        "correctCount": { "type": "number" },
        "joinedAt": { "type": "string" },
        "lastAnswerSubmittedAt": { "type": "string" }
      },
      "required": ["id", "competitionId", "userId", "displayName"]
    },
    "CommunityMessage": {
      "title": "CommunityMessage",
      "description": "Real-time message in a worldwide fellowship channel",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "channelId": { "type": "string", "maxLength": 60 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 80 },
        "userAvatar": { "type": "string", "maxLength": 500 },
        "userCountry": { "type": "string", "maxLength": 80 },
        "content": { "type": "string", "maxLength": 1000 },
        "replyToId": { "type": "string", "maxLength": 128 },
        "scriptureRef": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "channelId", "userId", "userName", "content"]
    },
    "PrayerRequest": {
      "title": "PrayerRequest",
      "description": "Prayer request shared with community or private",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 80 },
        "userCountry": { "type": "string", "maxLength": 80 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1500 },
        "category": { "type": "string", "maxLength": 60 },
        "isPublic": { "type": "boolean" },
        "isAnswered": { "type": "boolean" },
        "answeredTestimony": { "type": "string", "maxLength": 1000 },
        "prayerCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "title", "description", "isPublic"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification for a member",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 120 },
        "message": { "type": "string", "maxLength": 300 },
        "type": { "type": "string", "enum": ["competition", "quiz", "community", "prayer", "system"] },
        "link": { "type": "string", "maxLength": 200 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "type"]
    },
    "Report": {
      "title": "Report",
      "description": "Report of inappropriate content or behavior",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reporterId": { "type": "string", "maxLength": 128 },
        "reportedItemType": { "type": "string", "enum": ["message", "prayer", "user"] },
        "reportedItemId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "dismissed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "reporterId", "reportedItemType", "reportedItemId", "reason"]
    },
    "BibleQuestion": {
      "title": "BibleQuestion",
      "description": "Authoritative Bible question in the global question bank with 5 difficulty levels and translation metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "questionText": { "type": "string", "maxLength": 1000 },
        "options": { "type": "string", "description": "JSON array of 4 option strings" },
        "correctAnswerIndex": { "type": "number", "description": "Index of the correct option (0-3), kept confidential on server" },
        "difficulty": { "type": "string", "enum": ["beginner", "developing", "intermediate", "advanced", "expert"] },
        "category": { "type": "string", "maxLength": 80 },
        "scriptureReferences": { "type": "string", "description": "Array of verified scripture references" },
        "explanation": { "type": "string", "maxLength": 1000 },
        "translationId": { "type": "string", "maxLength": 40 },
        "translationName": { "type": "string", "maxLength": 80 },
        "reviewStatus": { "type": "string", "enum": ["draft", "needs_review", "approved", "retired"] },
        "verificationNotes": { "type": "string", "maxLength": 500 },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "questionText", "difficulty", "category", "translationId", "reviewStatus"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public profile and quiz statistics of a member"
    },
    "/quizzes/{quizId}": {
      "schema": "Quiz",
      "description": "Quiz metadata and settings"
    },
    "/quizzes/{quizId}/questions/{questionId}": {
      "schema": "QuizQuestion",
      "description": "Questions belonging to a quiz"
    },
    "/questionBank/{questionId}": {
      "schema": "BibleQuestion",
      "description": "Central repository of verified Bible quiz questions"
    },
    "/quizAttempts/{attemptId}": {
      "schema": "QuizAttempt",
      "description": "Completed quiz attempt record"
    },
    "/competitions/{competitionId}": {
      "schema": "Competition",
      "description": "Scheduled or live Bible quiz competition"
    },
    "/competitions/{competitionId}/participants/{participantId}": {
      "schema": "CompetitionParticipant",
      "description": "Participant in a competition"
    },
    "/messages/{messageId}": {
      "schema": "CommunityMessage",
      "description": "Community fellowship messages across channels"
    },
    "/prayerRequests/{prayerId}": {
      "schema": "PrayerRequest",
      "description": "Prayer requests and testimonies"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Reports submitted for moderation"
    }
  }
}
